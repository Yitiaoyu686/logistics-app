];
    id: 'TRF001',
    transferNo: 'TRF-20240115-001',
    direction: 'SATELLITE_TO_MAIN',
    sourceWarehouse: '佛山卫星仓',
    targetWarehouse: '广州总仓',
    orderId: 'ORD-20240101',
    trackingNo: 'SF1234567890',
    shippingUnitNo: 'MSKU1234567',
    pieces: 5,
    weight: 125.5,
